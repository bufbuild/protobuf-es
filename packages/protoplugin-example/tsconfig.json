{
  "include": ["src/**/*.ts", "test/*.ts"],
  "compilerOptions": {
    "rootDir": ".",
    "target": "es2017",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  }
}
