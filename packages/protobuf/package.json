      },
      "require": {
        "types": "./dist/commonjs/wkt/google/protobuf/go_features_pb.d.ts",
        "default": "./dist/commonjs/wkt/google/protobuf/go_features_pb.js"
      }
    },
    "./wkt/google/protobuf/java_features_pb.js": {
      "import": {
        "types": "./dist/esm/wkt/google/protobuf/java_features_pb.d.ts",
