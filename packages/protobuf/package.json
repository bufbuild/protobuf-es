{
  "name": "@bufbuild/protobuf",
  "version": "2.16.0",
  "license": "(Apache-2.0 AND BSD-3-Clause)",
  "description": "Protocol Buffers for ECMAScript. Fully compliant with the Protobuf conformance tests.",
  "keywords": ["protobuf", "schema", "typescript", "ecmascript"],
  "homepage": "https://protobufes.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/bufbuild/protobuf-es.git",
    "directory": "packages/protobuf"
  },
  "scripts": {
    "prebuild": "rm -rf ./dist/*",
    "build": "npm run build:cjs && npm run build:esm",
    "build:cjs": "../../node_modules/typescript/bin/tsc --project tsconfig.json --module commonjs --verbatimModuleSyntax false --moduleResolution node10 --ignoreDeprecations 6.0 --outDir ./dist/cjs && echo >./dist/cjs/package.json '{\"type\":\"commonjs\"}'",
    "build:esm": "../../node_modules/typescript/bin/tsc --project tsconfig.json --outDir ./dist/esm",
    "bootstrap": "npm run bootstrap:inject && npm run bootstrap:wkt",
    "bootstrap:inject": "node scripts/bootstrap-inject.mjs src",
    "bootstrap:wkt": "protoc --es_out=src/wkt --es_opt=bootstrap_wkt=true,target=ts,import_extension=js,json_types=true --proto_path $(upstream-include wkt) $(upstream-files wkt)",
    "postbootstrap:wkt": "license-header src/wkt/google",
    "format": "biome format --write",
    "license-header": "license-header --ignore 'src/wire/varint.ts'",
    "lint": "biome lint --error-on-warnings",
    "attw": "attw --pack"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./codegenv1": {
      "import": "./dist/esm/codegenv1/index.js",
      "require": "./dist/cjs/codegenv1/index.js"
    },
    "./codegenv2": {
      "import": "./dist/esm/codegenv2/index.js",
      "require": "./dist/cjs/codegenv2/index.js"
    },
    "./reflect": {
      "import": "./dist/esm/reflect/index.js",
      "require": "./dist/cjs/reflect/index.js"
    },
    "./wire": {
      "import": "./dist/esm/wire/index.js",
      "require": "./dist/cjs/wire/index.js"
    },
    "./txtpb": {
      "import": "./dist/esm/txtpb/index.js",
      "require": "./dist/cjs/txtpb/index.js"
    },
    "./wkt": {
      "import": "./dist/esm/wkt/index.js",
      "require": "./dist/cjs/wkt/index.js"
    },
    "./wkt/google/protobuf/compiler/plugin_pb.js": {
      "import": "./dist/esm/wkt/google/protobuf/compiler/plugin_pb.js",
      "require": "./dist/cjs/wkt/google/protobuf/compiler/plugin_pb.js"
    },
    "./wkt/google/protobuf/any_pb.js": {
      "import": "./dist/esm/wkt/google/protobuf/any_pb.js",
      "require": "./dist/cjs/wkt/google/protobuf/any_pb.js"
    },
    "./wkt/google/protobuf/api_pb.js": {
      "import": "./dist/esm/wkt/google/protobuf/api_pb.js",
      "require": "./dist/cjs/wkt/google/protobuf/api_pb.js"
    },
    "./wkt/google/protobuf/c_sharp_features_pb.js": {
      "import": "./dist/esm/wkt/google/protobuf/c_sharp_features_pb.js",
      "require": "./dist/cjs/wkt/google/protobuf/c_sharp_features_pb.js"
    },
    "./wkt/google/protobuf/cpp_features_pb.js": {
      "import": "./dist/esm/wkt/google/protobuf/cpp_features_pb.js",
      "require": "./dist/cjs/wkt/google/protobuf/cpp_features_pb.js"
    },
    "./wkt/google/protobuf/cpp_file_options_pb.js": {
      "import": "./dist/esm/wkt/google/protobuf/cpp_file_options_pb.js",
      "require": "./dist/cjs/wkt/google/protobuf/cpp_file_options_pb.js"
    },
    "./wkt/google/protobuf/cpp_options_pb.js": {
      "import": "./dist/esm/wkt/google/protobuf/cpp_options_pb.js",
      "require": "./dist/cjs/wkt/google/protobuf/cpp_options_pb.js"
    },
    "./wkt/google/protobuf/descriptor_pb.js": {
      "import": "./dist/esm/wkt/google/protobuf/descriptor_pb.js",
      "require": "./dist/cjs/wkt/google/protobuf/descriptor_pb.js"
    },
    "./wkt/google/protobuf/duration_pb.js": {
      "import": "./dist/esm/wkt/google/protobuf/duration_pb.js",
      "require": "./dist/cjs/wkt/google/protobuf/duration_pb.js"
    },
    "./wkt/google/protobuf/empty_pb.js": {
      "import": "./dist/esm/wkt/google/protobuf/empty_pb.js",
      "require": "./dist/cjs/wkt/google/protobuf/empty_pb.js"
    },
    "./wkt/google/protobuf/field_mask_pb.js": {
      "import": "./dist/esm/wkt/google/protobuf/field_mask_pb.js",
      "require": "./dist/cjs/wkt/google/protobuf/field_mask_pb.js"
    },
    "./wkt/google/protobuf/go_features_pb.js": {
      "import": "./dist/esm/wkt/google/protobuf/go_features_pb.js",
      "require": "./dist/cjs/wkt/google/protobuf/go_features_pb.js"
    },
    "./wkt/google/protobuf/java_features_pb.js": {
      "import": "./dist/esm/wkt/google/protobuf/java_features_pb.js",
      "require": "./dist/cjs/wkt/google/protobuf/java_features_pb.js"
    },
    "./wkt/google/protobuf/json_enumvalue_options_pb.js": {
      "import": "./dist/esm/wkt/google/protobuf/json_enumvalue_options_pb.js",
      "require": "./dist/cjs/wkt/google/protobuf/json_enumvalue_options_pb.js"
    },
    "./wkt/google/protobuf/json_options_pb.js": {
      "import": "./dist/esm/wkt/google/protobuf/json_options_pb.js",
      "require": "./dist/cjs/wkt/google/protobuf/json_options_pb.js"
    },
    "./wkt/google/protobuf/source_context_pb.js": {
      "import": "./dist/esm/wkt/google/protobuf/source_context_pb.js",
      "require": "./dist/cjs/wkt/google/protobuf/source_context_pb.js"
    },
    "./wkt/google/protobuf/struct_pb.js": {
      "import": "./dist/esm/wkt/google/protobuf/struct_pb.js",
      "require": "./dist/cjs/wkt/google/protobuf/struct_pb.js"
    },
    "./wkt/google/protobuf/timestamp_pb.js": {
      "import": "./dist/esm/wkt/google/protobuf/timestamp_pb.js",
      "require": "./dist/cjs/wkt/google/protobuf/timestamp_pb.js"
    },
    "./wkt/google/protobuf/type_pb.js": {
      "import": "./dist/esm/wkt/google/protobuf/type_pb.js",
      "require": "./dist/cjs/wkt/google/protobuf/type_pb.js"
    },
    "./wkt/google/protobuf/wrappers_pb.js": {
      "import": "./dist/esm/wkt/google/protobuf/wrappers_pb.js",
      "require": "./dist/cjs/wkt/google/protobuf/wrappers_pb.js"
    }
  },
  "typesVersions": {
    "*": {
      "codegenv1": ["./dist/cjs/codegenv1/index.d.ts"],
      "codegenv2": ["./dist/cjs/codegenv2/index.d.ts"],
      "reflect": ["./dist/cjs/reflect/index.d.ts"],
      "wkt": ["./dist/cjs/wkt/index.d.ts"],
      "wkt/google/protobuf/*.js": ["./dist/cjs/wkt/google/protobuf/*.d.ts"],
      "wire": ["./dist/cjs/wire/index.d.ts"],
      "txtpb": ["./dist/cjs/txtpb/index.d.ts"]
    }
  },
  "devDependencies": {
    "upstream-protobuf": "*"
  },
  "files": ["dist/**"]
}
