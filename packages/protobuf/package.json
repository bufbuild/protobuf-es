        "types": "./dist/esm/txtpb/index.d.ts",
        "default": "./dist/esm/txtpb/index.js"
      },
      "require": {
        "types": "./dist/commonjs/txtpb/index.d.ts",
        "default": "./dist/commonjs/txtpb/index.js"
      }
    },
    "./wkt": {
