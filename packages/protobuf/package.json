      }
    },
    "./wkt/google/protobuf/timestamp_pb.js": {
      "import": {
        "types": "./dist/esm/wkt/google/protobuf/timestamp_pb.d.ts",
        "default": "./dist/esm/wkt/google/protobuf/timestamp_pb.js"
      },
      "require": {
        "types": "./dist/commonjs/wkt/google/protobuf/timestamp_pb.d.ts",
        "default": "./dist/commonjs/wkt/google/protobuf/timestamp_pb.js"
      }
    },
    "./wkt/google/protobuf/type_pb.js": {
      "import": {
        "types": "./dist/esm/wkt/google/protobuf/type_pb.d.ts",
        "default": "./dist/esm/wkt/google/protobuf/type_pb.js"
      },
      "require": {
        "types": "./dist/commonjs/wkt/google/protobuf/type_pb.d.ts",
        "default": "./dist/commonjs/wkt/google/protobuf/type_pb.js"
      }
    },
    "./wkt/google/protobuf/wrappers_pb.js": {
      "import": {
        "types": "./dist/esm/wkt/google/protobuf/wrappers_pb.d.ts",
        "default": "./dist/esm/wkt/google/protobuf/wrappers_pb.js"
      },
      "require": {
        "types": "./dist/commonjs/wkt/google/protobuf/wrappers_pb.d.ts",
        "default": "./dist/commonjs/wkt/google/protobuf/wrappers_pb.js"
      }
    }
  },
  "main": "./dist/commonjs/index.js",
  "types": "./dist/commonjs/index.d.ts",
  "module": "./dist/esm/index.js",
  "typesVersions": {
    "*": {
      "codegenv1": [
        "./dist/commonjs/codegenv1/index.d.ts"
      ],
      "codegenv2": [
        "./dist/commonjs/codegenv2/index.d.ts"
      ],
      "reflect": [
        "./dist/commonjs/reflect/index.d.ts"
      ],
      "wkt": [
        "./dist/commonjs/wkt/index.d.ts"
      ],
      "wkt/google/protobuf/*.js": [
        "./dist/commonjs/wkt/google/protobuf/*.d.ts"
      ],
      "wire": [
        "./dist/commonjs/wire/index.d.ts"
      ],
      "txtpb": [
        "./dist/commonjs/txtpb/index.d.ts"
      ]
    }
  }
}
