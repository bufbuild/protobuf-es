{
  "name": "@bufbuild/protobuf",
  "version": "2.15.0",
  "license": "(Apache-2.0 AND BSD-3-Clause)",
  "description": "Protocol Buffers for ECMAScript. Fully compliant with the Protobuf conformance tests.",
  "keywords": [
    "protobuf",
    "schema",
    "typescript",
    "ecmascript"
  ],
  "homepage": "https://protobufes.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/bufbuild/protobuf-es.git",
    "directory": "packages/protobuf"
  },
  "scripts": {
    "build": "tshy",
    "bootstrap": "npm run bootstrap:inject && npm run bootstrap:wkt",
    "bootstrap:inject": "node scripts/bootstrap-inject.mjs src",
    "bootstrap:wkt": "protoc --es_out=src/wkt --es_opt=bootstrap_wkt=true,target=ts,import_extension=js,json_types=true --proto_path $(upstream-include wkt) $(upstream-files wkt)",
    "postbootstrap:wkt": "license-header src/wkt/google",
    "format": "biome format --write",
    "license-header": "license-header --ignore 'src/wire/varint.ts'",
    "lint": "biome lint --error-on-warnings",
    "attw": "attw --pack"
  },
  "type": "module",
  "sideEffects": false,
  "tshy": {
    "selfLink": false,
    "exports": {
      ".": "./src/index.ts",
      "./codegenv1": "./src/codegenv1/index.ts",
      "./codegenv2": "./src/codegenv2/index.ts",
      "./reflect": "./src/reflect/index.ts",
      "./wire": "./src/wire/index.ts",
      "./txtpb": "./src/txtpb/index.ts",
      "./wkt": "./src/wkt/index.ts",
      "./wkt/google/protobuf/compiler/plugin_pb.js": "./src/wkt/google/protobuf/compiler/plugin_pb.ts",
      "./wkt/google/protobuf/any_pb.js": "./src/wkt/google/protobuf/any_pb.ts",
      "./wkt/google/protobuf/api_pb.js": "./src/wkt/google/protobuf/api_pb.ts",
      "./wkt/google/protobuf/cpp_features_pb.js": "./src/wkt/google/protobuf/cpp_features_pb.ts",
      "./wkt/google/protobuf/descriptor_pb.js": "./src/wkt/google/protobuf/descriptor_pb.ts",
      "./wkt/google/protobuf/duration_pb.js": "./src/wkt/google/protobuf/duration_pb.ts",
      "./wkt/google/protobuf/empty_pb.js": "./src/wkt/google/protobuf/empty_pb.ts",
      "./wkt/google/protobuf/field_mask_pb.js": "./src/wkt/google/protobuf/field_mask_pb.ts",
      "./wkt/google/protobuf/go_features_pb.js": "./src/wkt/google/protobuf/go_features_pb.ts",
      "./wkt/google/protobuf/java_features_pb.js": "./src/wkt/google/protobuf/java_features_pb.ts",
      "./wkt/google/protobuf/source_context_pb.js": "./src/wkt/google/protobuf/source_context_pb.ts",
      "./wkt/google/protobuf/struct_pb.js": "./src/wkt/google/protobuf/struct_pb.ts",
      "./wkt/google/protobuf/timestamp_pb.js": "./src/wkt/google/protobuf/timestamp_pb.ts",
      "./wkt/google/protobuf/type_pb.js": "./src/wkt/google/protobuf/type_pb.ts",
      "./wkt/google/protobuf/wrappers_pb.js": "./src/wkt/google/protobuf/wrappers_pb.ts"
    }
  },
  "devDependencies": {
    "tshy": "^4.1.3",
    "upstream-protobuf": "*"
  },
  "files": [
    "dist/**"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    },
    "./codegenv1": {
      "import": {
        "types": "./dist/esm/codegenv1/index.d.ts",
        "default": "./dist/esm/codegenv1/index.js"
      },
      "require": {
        "types": "./dist/commonjs/codegenv1/index.d.ts",
        "default": "./dist/commonjs/codegenv1/index.js"
      }
    },
    "./codegenv2": {
      "import": {
        "types": "./dist/esm/codegenv2/index.d.ts",
        "default": "./dist/esm/codegenv2/index.js"
      },
      "require": {
        "types": "./dist/commonjs/codegenv2/index.d.ts",
        "default": "./dist/commonjs/codegenv2/index.js"
      }
    },
    "./reflect": {
      "import": {
        "types": "./dist/esm/reflect/index.d.ts",
        "default": "./dist/esm/reflect/index.js"
      },
      "require": {
        "types": "./dist/commonjs/reflect/index.d.ts",
        "default": "./dist/commonjs/reflect/index.js"
      }
    },
    "./wire": {
      "import": {
        "types": "./dist/esm/wire/index.d.ts",
        "default": "./dist/esm/wire/index.js"
      },
      "require": {
        "types": "./dist/commonjs/wire/index.d.ts",
        "default": "./dist/commonjs/wire/index.js"
      }
    },
    "./txtpb": {
