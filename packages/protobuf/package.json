      },
      "require": {
        "types": "./dist/commonjs/wkt/google/protobuf/empty_pb.d.ts",
        "default": "./dist/commonjs/wkt/google/protobuf/empty_pb.js"
      }
    },
    "./wkt/google/protobuf/field_mask_pb.js": {
      "import": {
