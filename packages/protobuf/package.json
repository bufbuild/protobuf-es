      },
      "require": {
        "types": "./dist/commonjs/wkt/google/protobuf/field_mask_pb.d.ts",
        "default": "./dist/commonjs/wkt/google/protobuf/field_mask_pb.js"
      }
    },
    "./wkt/google/protobuf/go_features_pb.js": {
      "import": {
