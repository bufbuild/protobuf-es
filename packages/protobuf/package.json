      },
      "require": {
        "types": "./dist/commonjs/wkt/index.d.ts",
        "default": "./dist/commonjs/wkt/index.js"
      }
    },
    "./wkt/google/protobuf/compiler/plugin_pb.js": {
      "import": {
        "types": "./dist/esm/wkt/google/protobuf/compiler/plugin_pb.d.ts",
        "default": "./dist/esm/wkt/google/protobuf/compiler/plugin_pb.js"
      },
      "require": {
        "types": "./dist/commonjs/wkt/google/protobuf/compiler/plugin_pb.d.ts",
        "default": "./dist/commonjs/wkt/google/protobuf/compiler/plugin_pb.js"
      }
    },
    "./wkt/google/protobuf/any_pb.js": {
      "import": {
        "types": "./dist/esm/wkt/google/protobuf/any_pb.d.ts",
        "default": "./dist/esm/wkt/google/protobuf/any_pb.js"
      },
      "require": {
        "types": "./dist/commonjs/wkt/google/protobuf/any_pb.d.ts",
        "default": "./dist/commonjs/wkt/google/protobuf/any_pb.js"
      }
    },
    "./wkt/google/protobuf/api_pb.js": {
      "import": {
        "types": "./dist/esm/wkt/google/protobuf/api_pb.d.ts",
        "default": "./dist/esm/wkt/google/protobuf/api_pb.js"
      },
      "require": {
        "types": "./dist/commonjs/wkt/google/protobuf/api_pb.d.ts",
        "default": "./dist/commonjs/wkt/google/protobuf/api_pb.js"
      }
    },
    "./wkt/google/protobuf/cpp_features_pb.js": {
      "import": {
        "types": "./dist/esm/wkt/google/protobuf/cpp_features_pb.d.ts",
        "default": "./dist/esm/wkt/google/protobuf/cpp_features_pb.js"
      },
      "require": {
        "types": "./dist/commonjs/wkt/google/protobuf/cpp_features_pb.d.ts",
        "default": "./dist/commonjs/wkt/google/protobuf/cpp_features_pb.js"
