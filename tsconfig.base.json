{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["ES2022"],
    // ES2022 defaults this to true; pin false to keep pre-ES2022 field semantics.
    "useDefineForClassFields": false,
    "declaration": true,
    // Prevent tsc from picking up @types/node and others
    "types": [],
    // We don't have dependencies that require interop
    "esModuleInterop": false,
    // As strict as possible
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "useUnknownInCatchVariables": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    // We're building with Node16 module resolution
    "moduleResolution": "Node16",
    "module": "Node16",
    "verbatimModuleSyntax": true,
    "skipLibCheck": false,
    // Silence TS 6.0 deprecation of moduleResolution=node10, which some builds still rely on.
    "ignoreDeprecations": "6.0",
  },
}
